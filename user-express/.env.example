# ===========================================
# LogosTech Healthcare - User Express Service
# ===========================================

# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/healthcare

# Keycloak Configuration
KEYCLOAK_SERVER_URL=http://localhost:7070
KEYCLOAK_REALM=healthcare-realm
KEYCLOAK_CLIENT_ID=user-express
KEYCLOAK_CLIENT_SECRET=user-express-secret-2024

# Keycloak Admin Configuration (pour la gestion des utilisateurs)
KEYCLOAK_ADMIN_URL=http://localhost:7070
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_USERNAME=ibtissem
KEYCLOAK_ADMIN_PASSWORD=ibtissem

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Cloudinary Configuration (pour les photos de profil)
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Frontend URLs
FRONTEND_SUCCESS_URL=http://localhost:4200/dashboard
FRONTEND_ERROR_URL=http://localhost:4200/auth/error

# Session Configuration
SESSION_SECRET=healthcare-session-secret-2024-very-long-and-secure

# Email Configuration (optionnel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@logostech.com
SMTP_PASS=your-app-password
SMTP_FROM=LogosTech Healthcare <noreply@logostech.com>

# Eureka Configuration
EUREKA_HOST=localhost
EUREKA_PORT=8761
SERVICE_NAME=USER-EXPRESS
SERVICE_PORT=3000
